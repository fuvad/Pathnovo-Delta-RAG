# ============================================================
# Document Delta & Grounded Chat — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — only .env.example belongs in the repo.
# ============================================================

# --- LLM Provider ---
LLM_PROVIDER=groq                  # "groq" (online) or "ollama" (offline)

# --- Groq (Online) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (Offline / Local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2   # sentence-transformers model name

# --- Qdrant Vector Database ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=document_chunks

# --- Ingestion Settings ---
OCR_ENABLED=true                   # enable OCR for scanned PDFs
OCR_LANGUAGE=eng                   # OCR language

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json                    # "json" or "console"
